// ===================================
// Guzel Meraki Studio — Prisma Schema
// PostgreSQL (Neon)
// ===================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---- Enums ----

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  SHIPPED
  DELIVERED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
}

enum EventType {
  WEDDING
  BIRTHDAY
  CORPORATE
  CUSTOM
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONFIRMED
  CLOSED
}

// ---- User ----

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // hashed
  phone     String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@map("users")
}

// ---- Category ----

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String? // Cloudinary URL
  createdAt   DateTime @default(now())

  products Product[]

  @@map("categories")
}

// ---- Product ----

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String
  price       Decimal       @db.Decimal(10, 2)
  images      String[] // Cloudinary URLs
  stock       Int           @default(0)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  variants   ProductVariant[]
  orderItems OrderItem[]

  @@map("products")
}

// ---- Product Variant (e.g. size, color) ----

model ProductVariant {
  id            String  @id @default(cuid())
  name          String // e.g. "Size", "Color"
  value         String // e.g. "Large", "Rose Gold"
  priceModifier Decimal @default(0) @db.Decimal(10, 2) // added to base price
  stock         Int     @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]

  @@map("product_variants")
}

// ---- Order ----
// Note: cart itself is NOT stored server-side (kept in browser storage
// on the client per the stateless architecture) — an Order row is only
// created once the customer proceeds to checkout.

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique // human-readable reference, e.g. "GMS-2026-0001"
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @db.Decimal(10, 2)
  customerName    String
  customerEmail   String
  customerPhone   String
  deliveryAddress String
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  items            OrderItem[]
  paymentAttempts  PaymentAttempt[]

  @@map("orders")
}

// ---- Order Item ----

model OrderItem {
  id       String  @id @default(cuid())
  quantity Int
  price    Decimal @db.Decimal(10, 2) // price at time of purchase (snapshot)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

// ---- Payment Attempt ----
// Every attempt is recorded, per the project requirement:
// "The system records every payment attempt."

model PaymentAttempt {
  id            String        @id @default(cuid())
  gateway       String // e.g. "safepay"
  status        PaymentStatus @default(INITIATED)
  transactionId String? // ID returned by the gateway
  rawResponse   Json? // full gateway response, stored for auditing/debugging
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment_attempts")
}

// ---- Event Decor Enquiry ----

model EventEnquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String
  eventType   EventType
  eventDate   DateTime?
  guestCount  Int?
  message     String
  status      EnquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("event_enquiries")
}

